-- Fix: null value in column "slug" of relation "products"
-- Safe to run more than once. No front-end changes needed.

-- 1) Make sure the slug column exists
alter table public.products add column if not exists slug text;

-- 2) Auto-generate a unique slug from the product name on every insert
create or replace function public.set_product_slug()
returns trigger
language plpgsql
as $$
declare
  base text;
begin
  if new.slug is null or btrim(new.slug) = '' then
    base := lower(regexp_replace(coalesce(new.name, 'product'), '[^a-zA-Z0-9]+', '-', 'g'));
    base := btrim(base, '-');
    if base = '' then base := 'product'; end if;
    new.slug := base || '-' || substr(replace(gen_random_uuid()::text, '-', ''), 1, 6);
  end if;
  return new;
end;
$$;

drop trigger if exists trg_set_product_slug on public.products;
create trigger trg_set_product_slug
  before insert on public.products
  for each row execute function public.set_product_slug();

-- 3) Fill slug for any existing rows that have none
update public.products
set slug = coalesce(nullif(btrim(lower(regexp_replace(coalesce(name,'product'), '[^a-zA-Z0-9]+', '-', 'g')), '-'), ''), 'product')
           || '-' || substr(replace(gen_random_uuid()::text, '-', ''), 1, 6)
where slug is null or btrim(slug) = '';

-- 4) Stop other leftover NOT NULL columns from blocking saves
--    (keeps id, name, slug, created_at required; relaxes everything else)
do $$
declare r record;
begin
  for r in
    select column_name
    from information_schema.columns
    where table_schema = 'public'
      and table_name = 'products'
      and is_nullable = 'NO'
      and column_name not in ('id', 'name', 'slug', 'created_at')
  loop
    execute format('alter table public.products alter column %I drop not null', r.column_name);
  end loop;
end $$;

notify pgrst, 'reload schema';
